{
  "name": "voxscript",
  "version": "0.2.0",
  "description": "음성 자동 번역 파이프라인 + Electron 데스크탑 앱",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently \"cd frontend && yarn dev\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "cd frontend && yarn build",
    "package": "yarn build && electron-builder",
    "electron": "electron ."
  },
  "build": {
    "appId": "com.terryblackhoodwoo.voxscript",
    "productName": "VOXScript",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "frontend/dist/**/*",
      "backend/**/*",
      "!backend/**/__pycache__",
      "!backend/**/*.pyc"
    ],
    "win": {
      "target": "nsis",
      "icon": "electron/assets/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "electron/assets/icon.icns"
    },
    "extraResources": [
      {
        "from": "backend",
        "to": "backend"
      }
    ]
  },
  "devDependencies": {
    "concurrently": "^8.2.0",
    "electron": "^32.0.0",
    "electron-builder": "^24.0.0",
    "wait-on": "^7.2.0"
  }
}
